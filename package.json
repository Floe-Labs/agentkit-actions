{
  "name": "floe-agent",
  "version": "0.6.2",
  "description": "Coinbase AgentKit ActionProvider for Floe DeFi lending protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Floe-Labs/agentkit-actions"
  },
  "homepage": "https://floefinance.com",
  "bugs": {
    "url": "https://github.com/Floe-Labs/agentkit-actions/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "defi",
    "lending",
    "agentkit",
    "coinbase",
    "ai-agent",
    "floe"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "floe-agent": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@coinbase/agentkit": "^0.2.0"
  },
  "dependencies": {
    "viem": "^2.0.0",
    "zod": "^3.22.0",
    "ai": "^6.0.116",
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/anthropic": "^1.0.0",
    "ai-sdk-ollama": "^3.8.1",
    "@inquirer/prompts": "^7.0.0",
    "@napi-rs/keyring": "^1.1.6",
    "chalk": "^5.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@coinbase/agentkit": "^0.2.0",
    "dotenv": "^17.3.1",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
